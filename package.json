{
  "name": "dsh-remote-control",
  "version": "0.9.8",
  "description": "Drive this DeepSeek Harness host from any browser by tunnelling the real web client through a relay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icrefin/dsh-remote-control.git"
  },
  "homepage": "https://github.com/icrefin/dsh-remote-control#readme",
  "bugs": {
    "url": "https://github.com/icrefin/dsh-remote-control/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "remote-control",
    "relay",
    "websocket",
    "tunnel",
    "mobile"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.17.0",
    "dsh": ">=0.2.1-rc.5 <0.2.2-0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "relay",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "pack": "pnpm build && pnpm pack --pack-destination dist"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.5.12",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "packageManager": "pnpm@11.20.0"
}
